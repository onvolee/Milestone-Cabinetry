{
  "name": "milestone-cabinetry-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "synth": "cdk synth --strict",
    "diff": "cdk diff --strict",
    "deploy:foundation": "cdk deploy ServerFoundationStack --require-approval never --outputs-file cdk-outputs-foundation.json",
    "bootstrap:database": "node scripts/run-database-bootstrap.mjs --outputs cdk-outputs-foundation.json",
    "deploy:application": "cdk deploy ServerApplicationStack --require-approval never --outputs-file cdk-outputs-application.json",
    "health": "node scripts/check-health.mjs --outputs cdk-outputs-application.json",
    "drift": "cdk drift --fail ServerFoundationStack ServerApplicationStack"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.268.0",
    "cdk-nag": "3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.1",
    "aws-cdk": "2.1140.0",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}

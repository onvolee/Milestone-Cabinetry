# Dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/cache/
**/.yarn/unplugged/
**/.yarn/install-state.gz

# Environment files and local secrets
**/.env*
!**/.env*.example
**/*.pem
**/*.key
**/*.crt

# Build output and framework caches
**/dist/
**/dist-ssr/
**/build/
**/coverage/
**/.next/
**/.open-next/
**/.sst/
**/out/
**/.turbo/
**/.vercel/

# TypeScript and tool caches
**/*.tsbuildinfo
**/next-env.d.ts

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local editor and OS files
**/.DS_Store
**/.idea/
**/.vscode/*
!**/.vscode/extensions.json
**/*.local

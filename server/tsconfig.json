{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "es2023",
    "module": "commonjs",
    "lib": ["es2023"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "moduleResolution": "node",
    "types": ["node"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": "./src",
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts", "./eslint.config.mjs"],
  "exclude": ["node_modules", "dist", "test/**/*", "**/*.spec.ts", "**/*.test.ts"]
}

NODE_ENV=local
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Use "iam" for an RDS PostgreSQL user granted rds_iam.
# The local AWS identity must have rds-db:connect for that database user.
# Optional. Set this only if you configured a named AWS CLI profile.
# AWS_PROFILE=personal
AWS_REGION=us-east-1
DB_AUTH_MODE=password
# Required for IAM auth. Download the AWS RDS global certificate bundle locally.
DB_SSL_CA_PATH=

# Set either DATABASE_URL or the individual DB_* variables when the database is ready.
# DATABASE_URL=postgres://username:password@localhost:5432/milestone_cabinetry
DB_HOST=localhost
DB_PORT=5432
DB_NAME=milestone_cabinetry
DB_USERNAME=postgres
DB_PASSWORD=
